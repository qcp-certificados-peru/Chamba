# El proceso lee variables exportadas; no carga este archivo automáticamente.
# En Render Free, conecta Drive; el disco local es temporal.
PUBLIC_BASE_URL=https://tu-portal.example.com
CERTIFICATE_STORAGE_BACKEND=local
CERTIFICATE_STORAGE_DIR=/data/certificates
PORT=8000
# Modo local: máximo 1, 2 o 3; se reduce según memoria. Drive usa un conversor.
CERTIFICATE_CONVERSION_WORKERS=2
# Para Drive cambia CERTIFICATE_STORAGE_BACKEND=drive y configura:
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
# Introduce estos secretos solo en Environment de Render, nunca en Git ni chat.
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
